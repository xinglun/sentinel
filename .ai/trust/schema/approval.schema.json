{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-cockpit://trust/approval.schema.json",
  "title": "Approval Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalType",
    "identityLevel",
    "actor",
    "provider",
    "evidence",
    "scope"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "approvalType": {
      "enum": ["destructive_change", "restricted_write", "policy_override", "release"]
    },
    "identityLevel": {
      "enum": [
        "self_declared",
        "repository_recorded",
        "provider_verified",
        "enterprise_verified",
        "direct_user_authorized"
      ]
    },
    "actor": {"type": "string", "minLength": 1},
    "provider": {"type": ["string", "null"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pullRequest": {"type": "integer"},
        "reviewId": {"type": ["integer", "string"]},
        "environmentApprovalId": {"type": ["integer", "string"]},
        "rulesetId": {"type": ["integer", "string"]},
        "commitSha": {"type": "string", "minLength": 1},
        "enterpriseSystem": {"type": "string", "minLength": 1},
        "externalReference": {"type": "string", "minLength": 1},
        "directUserInstructionRef": {"type": "string", "minLength": 1},
        "directUserInstructionDigest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "authorizedAt": {"type": "string", "format": "date-time"}
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "approvalType": "destructive_change",
      "identityLevel": "provider_verified",
      "actor": "github-user",
      "provider": "github",
      "evidence": {
        "repository": "org/repo",
        "pullRequest": 123,
        "reviewId": 456,
        "commitSha": "0123456789abcdef0123456789abcdef01234567"
      },
      "scope": ["src/api/public.py"]
    }
  ]
}
