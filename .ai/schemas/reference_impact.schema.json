{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cockpit.example/schemas/reference-impact.schema.json",
  "title": "AI Cockpit Reference Impact Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "target", "referenceAnalysis", "governanceEvidence"],
  "properties": {
    "version": {"const": 1},
    "requestedText": {"type": "string"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "path", "operation"],
      "properties": {
        "type": {
          "enum": [
            "api",
            "class",
            "cli_option",
            "configuration_key",
            "database_field",
            "environment_variable",
            "feature_flag",
            "function",
            "make_target",
            "method",
            "script_entrypoint",
            "workflow_job",
            "file",
            "directory",
            "package",
            "module",
            "build_module",
            "serialization_format"
          ]
        },
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "operation": {
          "enum": [
            "change_signature",
            "change_visibility",
            "delete",
            "deprecate",
            "move",
            "remove_configuration",
            "remove_public_api",
            "rename"
          ]
        }
      }
    },
    "referenceAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dynamicReferences", "externalConsumers", "monitoringReferences"],
      "properties": {
        "staticReferences": {"$ref": "#/$defs/pathList"},
        "testReferences": {"$ref": "#/$defs/pathList"},
        "configurationReferences": {"$ref": "#/$defs/pathList"},
        "documentationReferences": {"$ref": "#/$defs/pathList"},
        "workflowReferences": {"$ref": "#/$defs/pathList"},
        "buildReferences": {"$ref": "#/$defs/pathList"},
        "dynamicReferences": {"$ref": "#/$defs/evidenceState"},
        "externalConsumers": {"$ref": "#/$defs/evidenceState"},
        "monitoringReferences": {"$ref": "#/$defs/evidenceState"}
      }
    },
    "governanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractDeclared",
        "acceptanceDeclared",
        "destructiveChangeAllowed",
        "evidence"
      ],
      "properties": {
        "contractDeclared": {"type": "boolean"},
        "acceptanceDeclared": {"type": "boolean"},
        "destructiveChangeAllowed": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityLevel", "approved"],
      "properties": {
        "identityLevel": {
          "enum": [
            "self_declared",
            "repository_recorded",
            "provider_verified",
            "enterprise_verified"
          ]
        },
        "approved": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evidenceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["unknown", "proven_absent", "present"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "stale": {"type": "boolean"}
      }
    }
  }
}
