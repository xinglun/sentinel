{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cockpit-template.invalid/schemas/evidence-binding.schema.json",
  "title": "AI Cockpit Evidence Binding",
  "description": "Versioned identity and freshness metadata for evidence considered by a later policy. A binding never grants authority to skip a required gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "bindingId",
    "subject",
    "classification",
    "dependencies",
    "scopeDigest",
    "governanceDigest",
    "producer",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "format": {"const": "ai-cockpit-evidence-binding"},
    "schemaVersion": {"const": 1},
    "bindingId": {"$ref": "#/$defs/digest"},
    "subject": {"$ref": "#/$defs/subject"},
    "classification": {"enum": ["content-bound", "diff-bound", "environment-bound"]},
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {"$ref": "#/$defs/contentDependency"},
        "diff": {"$ref": "#/$defs/diffDependency"},
        "environment": {"$ref": "#/$defs/environmentDependency"}
      },
      "minProperties": 1,
      "maxProperties": 1
    },
    "scopeDigest": {"$ref": "#/$defs/digest"},
    "governanceDigest": {"$ref": "#/$defs/digest"},
    "producer": {"$ref": "#/$defs/producer"},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"const": "content-bound"}}},
      "then": {"properties": {"dependencies": {"required": ["content"]}}}
    },
    {
      "if": {"properties": {"classification": {"const": "diff-bound"}}},
      "then": {"properties": {"dependencies": {"required": ["diff"]}}}
    },
    {
      "if": {"properties": {"classification": {"const": "environment-bound"}}},
      "then": {"properties": {"dependencies": {"required": ["environment"]}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workItemId", "evidenceId"],
      "properties": {
        "workItemId": {"type": "string", "minLength": 1, "maxLength": 128},
        "evidenceId": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "contentDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "paths"],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "diffDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseCommit", "headCommit", "changedPathsDigest"],
      "properties": {
        "baseCommit": {"$ref": "#/$defs/commit"},
        "headCommit": {"$ref": "#/$defs/commit"},
        "changedPathsDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "environmentDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "runtime", "toolchain"],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "runtime": {"type": "string", "minLength": 1},
        "toolchain": {"type": "string", "minLength": 1}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "version"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
