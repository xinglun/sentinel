{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Cockpit Work Item Status Interface",
  "type": "object",
  "required": [
    "schemaVersion",
    "workItem",
    "state",
    "phase",
    "blocking",
    "blockers",
    "humanDecisionRequired",
    "safeActions",
    "baseCommit",
    "branch",
    "lastVerificationAt",
    "evidenceFreshness",
    "diagnostics",
    "sourceDigests",
    "updatedAt",
    "statusDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "workItem": {"type": "string", "minLength": 1},
    "state": {"enum": ["green", "yellow", "red", "unknown"]},
    "phase": {"enum": ["intake", "preflight", "implementation", "verification", "review", "finish", "closure", "closed", "unknown"]},
    "blocking": {"type": "boolean"},
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "detail"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "humanDecisionRequired": {"type": "boolean"},
    "safeActions": {
      "type": "array",
      "items": {"enum": ["review_evidence", "review_risks", "request_human_decision", "stop", "resolve_blockers", "inspect_evidence", "refresh_status"]}
    },
    "baseCommit": {"type": ["string", "null"]},
    "branch": {"type": ["string", "null"]},
    "lastVerificationAt": {"type": ["string", "null"], "format": "date-time"},
    "evidenceFreshness": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": {"enum": ["fresh", "stale", "unknown"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "diagnostics": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sourceDigests": {
      "type": "object",
      "required": ["contract", "summary"],
      "properties": {
        "contract": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "summary": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "updatedAt": {"type": "string", "format": "date-time"},
    "statusDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
