{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Cockpit Work Item Intelligence Snapshot",
  "type": "object",
  "required": ["schemaVersion", "identity", "status", "progressFacts", "blockingReasons", "missingEvidence", "dependencies", "humanDecisions", "risks", "verification", "actionEligibility", "currentActivity", "statusVersion", "factSequence", "snapshotDigest"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "identity": {"type": "object", "required": ["workItemId"]},
    "status": {"type": "object", "required": ["lifecyclePhase", "governanceState", "activityHealth"]},
    "progressFacts": {"type": "object"},
    "blockingReasons": {"type": "array"},
    "missingEvidence": {"type": "array"},
    "dependencies": {"type": "array"},
    "humanDecisions": {"type": "array"},
    "risks": {"type": "array"},
    "verification": {"type": "object"},
    "actionEligibility": {"type": "object"},
    "currentActivity": {"type": "object"},
    "statusVersion": {"type": "integer", "minimum": 1},
    "versions": {
      "type": "object",
      "required": ["governance", "sourceSequence", "runtimeObservation"],
      "properties": {
        "governance": {"type": "integer", "minimum": 0},
        "sourceSequence": {"type": "integer", "minimum": 0},
        "runtimeObservation": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "sourceValidation": {
      "type": "object",
      "description": "Validation of V2 sourceRef evidence. A sourceRef path is repository-relative, has no parent traversal, and may resolve only within the queried repository root.",
      "required": ["valid", "records"],
      "properties": {
        "valid": {"type": "boolean"},
        "records": {"type": "array"}
      }
    },
    "subjects": {"type": "array"},
    "governance": {"type": "object", "required": ["lifecyclePhase", "state", "version"]},
    "runtimeObservation": {"type": "object", "required": ["activityHealth", "version"]},
    "completion": {
      "type": "object",
      "required": ["implementation", "verification", "review", "integration", "closure"],
      "properties": {
        "implementation": {"$ref": "#/$defs/completionPhase"},
        "verification": {"$ref": "#/$defs/completionPhase"},
        "review": {"$ref": "#/$defs/completionPhase"},
        "integration": {"$ref": "#/$defs/completionPhase"},
        "closure": {"$ref": "#/$defs/completionPhase"}
      },
      "additionalProperties": false
    },
    "governancePermissions": {
      "description": "V2 read-only local phase decisions. They explain eligibility evidence but do not grant authority or schedule work.",
      "type": "object",
      "required": ["statusVersion", "basis", "implementation", "verification", "finish", "closure"],
      "properties": {
        "statusVersion": {"type": "integer", "minimum": 1},
        "basis": {
          "type": "object",
          "required": ["governanceState", "governanceVersion"],
          "properties": {
            "governanceState": {"type": "string"},
            "governanceVersion": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "implementation": {"$ref": "#/$defs/governancePermission"},
        "verification": {"$ref": "#/$defs/governancePermission"},
        "finish": {"$ref": "#/$defs/governancePermission"},
        "closure": {"$ref": "#/$defs/governancePermission"}
      },
      "additionalProperties": false
    },
    "factSequence": {"type": "integer", "minimum": 0},
    "lastFactId": {"type": ["string", "null"]},
    "snapshotDigest": {"type": "string", "pattern": "^sha256:"}
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}},
      "then": {"required": ["versions", "sourceValidation", "subjects", "governance", "runtimeObservation", "completion", "governancePermissions"]}
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "completionPhase": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["not_started", "in_progress", "completed", "failed", "invalidated", "unknown"]},
        "lastFactId": {"type": "string"},
        "lastPassedFactId": {"type": "string"},
        "invalidatedBy": {"type": "string"}
      },
      "additionalProperties": false
    },
    "governancePermission": {
      "type": "object",
      "required": ["allowed", "reasonCodes", "conditions", "evidenceBasis"],
      "properties": {
        "allowed": {"type": "boolean"},
        "reasonCodes": {"type": "array", "items": {"type": "string"}},
        "conditions": {
          "type": "object",
          "required": ["requiredGovernanceStates"],
          "properties": {
            "requiredGovernanceStates": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "evidenceBasis": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
