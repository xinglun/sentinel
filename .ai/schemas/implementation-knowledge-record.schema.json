{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cockpit.invalid/schemas/implementation-knowledge-record.schema.json",
  "title": "AI Cockpit implementation knowledge record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workItemId",
    "title",
    "topics",
    "components",
    "implementation",
    "configuration",
    "changes",
    "designDecisions",
    "effects",
    "evidence",
    "mergedCommit",
    "currentValidity",
    "supersedes",
    "generatedFrom",
    "knowledgeState",
    "unknowns"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "workItemId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "topics": {"type": "array", "items": {"type": "string"}},
    "components": {"type": "array", "items": {"type": "string"}},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "effectiveState": {
      "enum": ["current", "superseded", "unknown", "historical_or_current_unknown"]
    },
    "implementation": {"$ref": "#/$defs/claim"},
    "configuration": {
      "anyOf": [{"$ref": "#/$defs/claim"}, {"type": "null"}]
    },
    "changes": {"type": "array", "items": {"type": "string"}},
    "designDecisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/designDecision"}
    },
    "effects": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "mergedCommit": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      ]
    },
    "currentValidity": {
      "enum": ["current", "superseded", "unknown"]
    },
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "generatedFrom": {"$ref": "#/$defs/generatedFrom"},
    "knowledgeState": {
      "enum": ["verified", "partial", "unknown", "superseded"]
    },
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "status"],
      "properties": {
        "summary": {"type": "string"},
        "status": {"enum": ["verified", "unknown", "incomplete"]}
      }
    },
    "designDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "status"],
      "properties": {
        "decision": {"type": "string"},
        "reason": {"type": "string"},
        "status": {"enum": ["verified", "unknown", "incomplete"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractPath",
        "contractDigest",
        "summaryPath",
        "summaryDigest",
        "outcomePath",
        "outcomeDigest"
      ],
      "properties": {
        "contractPath": {"type": "string", "minLength": 1},
        "contractDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "summaryPath": {"type": "string", "minLength": 1},
        "summaryDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "outcomePath": {"type": "string", "minLength": 1},
        "outcomeDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
