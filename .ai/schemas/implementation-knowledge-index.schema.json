{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cockpit.invalid/schemas/implementation-knowledge-index.schema.json",
  "title": "AI Cockpit implementation knowledge index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workItems"],
  "properties": {
    "schemaVersion": {"const": 1},
    "workItems": {
      "type": "array",
      "items": {"$ref": "#/$defs/indexEntry"}
    }
  },
  "$defs": {
    "indexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemId",
        "title",
        "topics",
        "components",
        "state",
        "knowledgePath"
      ],
      "properties": {
        "workItemId": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "topics": {"type": "array", "items": {"type": "string"}},
        "components": {"type": "array", "items": {"type": "string"}},
        "state": {"enum": ["verified", "partial", "unknown", "superseded"]},
        "knowledgePath": {"type": "string", "minLength": 1}
      }
    }
  }
}
