{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Cockpit Parallel Verification Plan",
  "type": "object",
  "required": ["schemaVersion", "maxWorkers", "jobs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "maxWorkers": {"type": "integer", "minimum": 1, "maximum": 8},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command", "scope"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "scope": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
