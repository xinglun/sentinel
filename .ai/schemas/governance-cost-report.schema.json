{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Cockpit Governance Cost Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "workItemId",
    "generatedAt",
    "source",
    "observed",
    "unknown",
    "advisory",
    "decisionImpact",
    "reportDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "workItemId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["kind", "ignoredCrossWorkItemEvents"],
      "properties": {
        "kind": {"const": "local_observability"},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^sha256:"},
        "ignoredCrossWorkItemEvents": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "observed": {
      "type": "object",
      "required": [
        "localComputeMs",
        "gateDurationMs",
        "phaseDurationsMs",
        "gateRuns",
        "verificationRuns",
        "retries",
        "backtracks",
        "humanDecisions"
      ],
      "properties": {
        "localComputeMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "gateDurationMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "phaseDurationsMs": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "gateRuns": {"type": "integer", "minimum": 0},
        "verificationRuns": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "backtracks": {"type": "integer", "minimum": 0},
        "humanDecisions": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "required": [
        "totalElapsedMs",
        "agentActiveMs",
        "verificationMs",
        "ciWaitMs",
        "humanWaitMs",
        "recoveryRetryMs",
        "phaseDurationsMs"
      ],
      "properties": {
        "totalElapsedMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "agentActiveMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "verificationMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "ciWaitMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "humanWaitMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "recoveryRetryMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "phaseDurationsMs": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["gateRuns", "verificationRuns", "retries", "backtracks", "humanDecisions"],
      "properties": {
        "gateRuns": {"type": "integer", "minimum": 0},
        "verificationRuns": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "backtracks": {"type": "integer", "minimum": 0},
        "humanDecisions": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "topBottlenecks": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "durationMs", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "durationMs": {"type": "integer", "minimum": 0},
          "source": {"type": "string", "enum": ["check_result", "explicit_wait", "explicit_recovery", "lifecycle_phase_finished"]}
        },
        "additionalProperties": false
      }
    },
    "unknown": {
      "type": "object",
      "required": ["providerWaitMs", "humanWaitMs", "recoveryRetryMs", "tokenUsage"],
      "properties": {
        "providerWaitMs": {"const": "unknown"},
        "humanWaitMs": {"const": "unknown"},
        "recoveryRetryMs": {"const": "unknown"},
        "tokenUsage": {
          "type": "object",
          "required": ["input", "output", "total"],
          "properties": {"input": {"const": "unknown"}, "output": {"const": "unknown"}, "total": {"const": "unknown"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "advisory": {"const": true},
    "decisionImpact": {"const": "none"},
    "reportDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
