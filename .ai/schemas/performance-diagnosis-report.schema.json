{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Cockpit Performance Diagnosis Report",
  "type": "object",
  "required": [
    "schemaVersion", "workItemId", "generatedAt", "source", "time", "execution",
    "tokenUsage", "topBottlenecks", "repeatedVerification", "contention",
    "baselineComparison", "diagnosis", "advisory", "decisionImpact", "reportDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "workItemId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["kind", "ignoredCrossWorkItemEvents"],
      "properties": {
        "kind": {"const": "local_observability"},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^sha256:"},
        "ignoredCrossWorkItemEvents": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "required": ["totalElapsedMs", "phaseDurationsMs", "providerWaitMs", "humanWaitMs", "recoveryRetryMs", "ciWaitMs", "resourceWaitMs"],
      "properties": {
        "totalElapsedMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "phaseDurationsMs": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "providerWaitMs": {"const": "unknown"},
        "humanWaitMs": {"const": "unknown"},
        "recoveryRetryMs": {"const": "unknown"},
        "ciWaitMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "resourceWaitMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["gateRuns", "verificationRuns", "retries", "backtracks", "humanDecisions"],
      "properties": {
        "gateRuns": {"type": "integer", "minimum": 0},
        "verificationRuns": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "backtracks": {"type": "integer", "minimum": 0},
        "humanDecisions": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "tokenUsage": {
      "type": "object",
      "required": ["input", "output", "total"],
      "properties": {"input": {"const": "unknown"}, "output": {"const": "unknown"}, "total": {"const": "unknown"}},
      "additionalProperties": false
    },
    "topBottlenecks": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "required": ["name", "durationMs", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "durationMs": {"type": "integer", "minimum": 0},
          "source": {"enum": ["check_result", "explicit_wait", "lifecycle_phase_finished"]}
        },
        "additionalProperties": false
      }
    },
    "repeatedVerification": {
      "type": "array",
      "items": {
        "type": "object", "required": ["checkId", "runId", "count"],
        "properties": {"checkId": {"type": "string"}, "runId": {"type": "string"}, "count": {"type": "integer", "minimum": 2}},
        "additionalProperties": false
      }
    },
    "contention": {
      "type": "object", "required": ["ciWaitMs", "resourceWaitMs"],
      "properties": {
        "ciWaitMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "resourceWaitMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]}
      },
      "additionalProperties": false
    },
    "baselineComparison": {
      "type": "object", "required": ["status", "fields", "limitations"],
      "properties": {
        "status": {"enum": ["not_provided", "compared", "incomparable"]},
        "fields": {"type": "object", "additionalProperties": {"type": "object"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "diagnosis": {
      "type": "object", "required": ["status", "limitations", "causalClaims"],
      "properties": {
        "status": {"enum": ["measured", "insufficient_evidence"]},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "causalClaims": {"const": []}
      },
      "additionalProperties": false
    },
    "advisory": {"const": true},
    "decisionImpact": {"const": "none"},
    "reportDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
