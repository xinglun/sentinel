{
  "contractVersion": 2,
  "workItemId": "example-task",
  "mode": "code",
  "title": "Example task",
  "baseCommit": "replace-with-git-head-at-task-start",
  "baselineDirtyPaths": [
    {
      "path": "scripts/ai_start.py",
      "status": "M",
      "fingerprint": "<sha256>"
    }
  ],
  "problemStatement": "このタスクが解決する問題を記述する。製品文脈がない場合は機械的変更であることを明記する。",
  "intent": {
    "problem": "必要に応じて課題を 1 文で記述する。",
    "constraints": [
      "必要に応じて制約を列挙する。"
    ],
    "rationale": "必要に応じて変更理由を記述する。"
  },
  "scope": [
    "src/example_module.ext",
    "tests/example_module_test.ext"
  ],
  "outOfScope": [
    "config/secrets.example"
  ],
  "sources": [
    {
      "path": "docs/specs/example.md",
      "reason": "実装根拠。"
    }
  ],
  "scenarioCoverage": [
    {
      "scenario": "example verified scenario",
      "required": true,
      "status": "verified",
      "evidence": [
        "make example-check"
      ]
    },
    {
      "scenario": "example unverified scenario",
      "required": true,
      "status": "unverified",
      "evidence": [],
      "reason": "外部システムの実行待ち。"
    },
    {
      "scenario": "example not applicable scenario",
      "required": false,
      "status": "not_applicable",
      "evidence": [],
      "reason": "この Work Item では旧経路に触れない。"
    }
  ],
  "unknowns": [],
  "notCodable": false,
  "riskAssessment": {
    "level": "medium",
    "riskTypes": [
      "scope_unclear",
      "review_debt"
    ],
    "reason": "実装前に review で問題化しそうな境界を明記する。"
  },
  "agentCapability": {
    "canImplement": true,
    "canVerify": true,
    "needsHumanDecision": false,
    "blockedReason": ""
  },
  "executionDecision": {
    "status": "continue",
    "reason": "Contract の scope / sources / acceptance / verification が確定している。"
  },
  "preReviewWarnings": [
    "review で重点確認すべき領域を Summary の reviewReadiness に残す。"
  ],
  "checkpointPolicy": {
    "requiredCheckpoints": [
      "contract_start",
      "before_edit",
      "before_ready",
      "after_verification"
    ],
    "reminder": "scope / acceptance / verification / agentCapability が変わった場合は Contract と Summary を更新してから進める。"
  },
  "acceptance": [
    "期待される振る舞いがテストまたは文書契約で固定されている。",
    "Gate / execution / trader / action matrix へ接続するか、表示・監査専用かが明記されている。",
    "Telegram / Markdown / CLI / audit daily / weekly review の表示範囲が明記されている。",
    "data branch / reports / JSONL / snapshot / weekly metrics の保存範囲が明記されている。",
    "i18n と snapshot / contract test の要否が明記されている。",
    "新しい運用 command は make target 経由で提供されている。",
    "checkpointEvidence に contract hash と required check の進捗が記録される。",
    "riskAssessment / agentCapability / executionDecision に、実装可能性、検証可能性、review 前のリスクが明記されている。",
    "checkpointPolicy に、contract_start / before_edit / before_ready / after_verification の確認点が明記されている。"
  ],
  "verification": [
    {
      "command": "make check-ai-contract CONTRACT=.ai/work-items/active/<task>.contract.json",
      "required": true
    },
    {
      "command": "make check-ai-scope CONTRACT=.ai/work-items/active/<task>.contract.json",
      "required": true
    },
    {
      "command": "make fmt-check",
      "required": true
    },
    {
      "command": "make test",
      "required": true
    },
    {
      "command": "make clippy",
      "required": true
    },
    {
      "command": "make check-ai-guards CONTRACT=.ai/work-items/active/<task>.contract.json",
      "required": true
    },
    {
      "command": "make check-ai-backtrack CONTRACT=.ai/work-items/active/<task>.contract.json SUMMARY=.ai/work-items/active/<task>.summary.json",
      "required": true
    },
    {
      "command": "make check-ai-scenario-coverage",
      "required": true
    },
    {
      "command": "make check-ai-change-summary SUMMARY=.ai/work-items/active/<task>.summary.json CONTRACT=.ai/work-items/active/<task>.contract.json",
      "required": true
    },
    {
      "command": "make generate-cockpit-status CONTRACT=.ai/work-items/active/<task>.contract.json SUMMARY=.ai/work-items/active/<task>.summary.json",
      "required": true
    },
    {
      "command": "make check-ai-status CONTRACT=.ai/work-items/active/<task>.contract.json SUMMARY=.ai/work-items/active/<task>.summary.json",
      "required": true
    }
  ],
  "destructiveChangePolicy": {
    "allowed": false,
    "requiresHumanApproval": true,
    "allowPatterns": []
  },
  "rollbackNote": "この task の diff を revert し、関連 test / docs を元に戻す。"
}
