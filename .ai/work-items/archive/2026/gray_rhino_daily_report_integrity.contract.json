  "riskAssessment": {
    "level": "low",
    "riskTypes": ["data_integrity", "evidence_insufficient"],
    "reason": "backfill 実行記録の日付を明示し、無日付 JSONL を正式な最新値から除外するだけで、判断系の境界は変更しない。"
  },
  "agentCapability": {
    "canImplement": true,
